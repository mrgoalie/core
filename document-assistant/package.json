{
  "name": "fabbrini-document-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Fabbrini Law Group — Document Assistant",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-dev.ts",
    "setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "purge-expired": "tsx scripts/purge-expired.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.1",
    "@azure/storage-blob": "^12.34.0",
    "@electric-sql/pglite": "^0.5.12",
    "decimal.js": "^10.6.0",
    "docx": "^9.14.0",
    "docxtemplater": "^3.71.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "$@azure/msal-node"
    }
  }
}
