# ---------------------------------------------------------------------------
# Fabbrini Law Group — Document Assistant: configuration
# Copy to .env.local for local development. In Azure, these are App Service
# "Application settings"; secrets are Key Vault references, never plain text.
# See docs/ENVIRONMENT.md for every setting.
# ---------------------------------------------------------------------------

# development | staging | production. Staging/production refuse unsafe settings.
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Local development uses an embedded PostgreSQL stored in ./data (no install needed).
# Production: postgres://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/docassist?sslmode=require
DATABASE_URL=pglite:./data/pglite

# development = fictional test employees, no Microsoft sign-in (never allowed in production)
# entra       = Microsoft 365 sign-in (see docs/ENTRA-SETUP.md)
AUTH_MODE=development
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI defaults to ${APP_BASE_URL}/api/auth/callback
ENTRA_REQUIRE_MFA_CLAIM=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12
# Comma-separated work emails created as administrators on first start (e.g. the firm owner).
BOOTSTRAP_ADMIN_EMAILS=

# local = encrypted files in ./data/storage; azure-blob = Azure Storage via managed identity
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=documents
# 32 random bytes, base64 (npm run generate-key). Required outside development.
STORAGE_ENCRYPTION_KEY=

# mock = fictional demonstration matters; clio = live Clio Manage (see docs/CLIO-SETUP.md)
CASE_MANAGEMENT=mock
CLIO_BASE_URL=https://app.clio.com
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
# CLIO_REDIRECT_URI defaults to ${APP_BASE_URL}/api/clio/callback

# AI provider credentials (the provider itself is chosen in Administration → Settings).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACKS=true

# basic = built-in checks; clamav = also scan with a ClamAV daemon
MALWARE_SCANNER=basic
CLAMAV_HOST=
CLAMAV_PORT=3310

# auto = LibreOffice when installed, otherwise the built-in PDF renderer
PDF_CONVERTER=auto
SOFFICE_PATH=soffice
MAX_UPLOAD_MB=25

# Fictional demonstration employees (defaults to true outside production).
SEED_DEMO_DATA=true
JOB_WORKER=true
# Set to true behind Azure App Service / Front Door so client IPs are logged correctly.
TRUST_PROXY_HEADERS=false
